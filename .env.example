# Neon PostgreSQL: one branch per environment (dev, qa, uat, production).
# Pooled string for the app, direct (no -pooler) string for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Sign-in (Auth.js). Generate the secret with: openssl rand -base64 32
AUTH_SECRET=""
# Google OAuth client (Google Cloud Console > APIs & Services > Credentials).
# Redirect URI: https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# The first sign-in with this email creates the organisation and the Founder account.
FOUNDER_EMAIL=""
ORG_NAME="AInformatIQ"
# Email-only test sign-in for local and preview builds. Never active in production.
DEV_LOGIN="1"

# Vercel Cron and other server-to-server calls send "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=""

# Find leads: Google Maps Platform key with "Places API (New)" enabled, and an Apollo API key.
GOOGLE_PLACES_API_KEY=""
APOLLO_API_KEY=""

# Discounts above this need founder approval (default 10).
DISCOUNT_LIMIT_PCT="10"

# Local database tests (npm test runs them when this is set).
TEST_DATABASE_URL=""

# AI research briefs (sprint 3) - tiered models as in BuilditNow
AI_ROUTINE_MODEL=""
AI_FRONTIER_MODEL=""
