{
  "name": "leaditnow",
  "version": "0.8.0",
  "private": true,
  "description": "LeadItNow - find Indian businesses that need software or IT services, show the evidence, and work them from first contact to signed MSA.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "scan": "tsx scripts/scan.ts",
    "vercel-build": "sh scripts/vercel-build.sh"
  },
  "dependencies": {
    "@neon/config": "^1.11.3",
    "@neon/env": "^1.6.15",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.0.0",
    "@vercel/functions": "^3.11.0",
    "next": "^15.0.0",
    "next-auth": "^5.0.0-beta.30",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^6.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
