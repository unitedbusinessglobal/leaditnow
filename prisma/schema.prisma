// LeadItNow data model. Every table carries orgId so the product can go multi-tenant later.

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  FOUNDER
  DIRECTOR
  BA
  SALES
  INTERN
}

enum DealStage {
  TARGET
  OUTREACH
  DISCOVERY
  PROTOTYPE_DEMO
  MOU_SCOPING
  MSA_SOW
  ONBOARD
  RENEW_EXPAND
  LOST
}

enum ActivityType {
  EMAIL
  WHATSAPP
  CALL
  MEETING
  NOTE
  STAGE_CHANGE
}

enum DocumentKind {
  MOU
  MSA
  SOW
  PROPOSAL
}

enum DocumentStatus {
  DRAFT
  SENT
  SIGNED
  DECLINED
}

enum SignalCategory {
  NEED
  STACK
}

enum ApprovalKind {
  DISCOUNT
  TERMS
  PRICING
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ScanStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

model Organization {
  id        String    @id @default(cuid())
  name      String
  plan      String    @default("internal")
  createdAt DateTime  @default(now())
  users     User[]
  accounts  Account[]
}

model User {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id])
  email     String       @unique
  name      String
  role      Role
  active    Boolean      @default(true)
  lastLoginAt DateTime?
  createdAt DateTime     @default(now())
  accounts  Account[]    @relation("AccountOwner")
  deals     Deal[]       @relation("DealOwner")
  tasks     Task[]       @relation("TaskOwner")
  activities Activity[]  @relation("ActivityUser")
}

model Account {
  id         String          @id @default(cuid())
  orgId      String
  org        Organization    @relation(fields: [orgId], references: [id])
  name       String
  domain     String
  gstin      String?
  industry   String?
  city       String?
  staffSize  Int?
  phone      String?
  source     String          @default("manual") // manual | csv:<file> | hubspot | apollo
  sourceNote String? // where the record came from and why we hold it (DPDP Act)
  notes      String?
  lastScannedAt DateTime?
  needScore   Int             @default(0)
  needLabel   String          @default("None")
  stack       String[]
  serviceHint String?
  fitScore    Int             @default(0)
  priority    Int             @default(0)
  ownerId    String?
  owner      User?           @relation("AccountOwner", fields: [ownerId], references: [id])
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  contacts   Contact[]
  signals    Signal[]
  scans      ScanRun[]
  briefs     ResearchBrief[]
  deals      Deal[]
  activities Activity[]

  @@unique([orgId, domain])
  @@index([orgId, phone])
  @@index([orgId, priority])
}

model Contact {
  id            String     @id @default(cuid())
  orgId         String
  accountId     String
  account       Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name          String
  title         String?
  email         String?
  phone         String?
  whatsappOptIn Boolean    @default(false)
  language      String     @default("en") // en | ta
  consentSource String // where we got this contact and why (DPDP Act)
  optedOutAt    DateTime?
  createdAt     DateTime   @default(now())
  activities    Activity[]
}

model Signal {
  id        String   @id @default(cuid())
  orgId     String
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ruleId      String
  category    SignalCategory
  serviceLine String?
  weight      Int
  evidence    String // DNS record or page URL plus matched text
  foundAt   DateTime @default(now())
  scanRunId String?
  manual    Boolean  @default(false)
  addedById String?

  @@index([accountId])
}

model ScanRun {
  id         String     @id @default(cuid())
  orgId      String
  accountId  String
  account    Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  status     ScanStatus @default(QUEUED)
  pages      String[]
  error      String?
  startedAt  DateTime   @default(now())
  finishedAt DateTime?
}

model ResearchBrief {
  id           String   @id @default(cuid())
  orgId        String
  accountId    String
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  summary      String
  processes    String
  needs        String
  sources      String[]
  model        String
  reviewedById String?
  createdAt    DateTime @default(now())
}

model Deal {
  id         String     @id @default(cuid())
  orgId      String
  accountId  String
  account    Account    @relation(fields: [accountId], references: [id])
  title      String
  serviceLine     String // ERP, CRM, SaaS, e-commerce, custom app, ITES, product
  indiaOriginated Boolean @default(false) // for the 60/40 revenue share under the intercompany agreement
  stage      DealStage  @default(TARGET)
  valueInr   Int?
  nextStep   String?
  nextStepAt DateTime?
  stageChangedAt DateTime @default(now())
  pain       String? // discovery: the problem in the client's words
  budgetInr  Int? // discovery: budget the client confirmed
  championContactId String? // demo: the person who backs us internally
  liveAt     DateTime? // onboard: client live in production
  lostReason String?
  discountPct Int       @default(0)
  ownerId    String?
  owner      User?      @relation("DealOwner", fields: [ownerId], references: [id])
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  activities Activity[]
  documents  Document[]
  approvals  Approval[]
  invoices   Invoice[]

  @@index([orgId, stage])
}

model Activity {
  id        String       @id @default(cuid())
  orgId     String
  type      ActivityType
  direction String? // in | out
  outcome   String?
  body      String?
  at        DateTime     @default(now())
  userId    String?
  user      User?        @relation("ActivityUser", fields: [userId], references: [id])
  accountId String?
  account   Account?     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contactId String?
  contact   Contact?     @relation(fields: [contactId], references: [id])
  dealId    String?
  deal      Deal?        @relation(fields: [dealId], references: [id])

  @@index([orgId, at])
  @@index([accountId])
}

model Task {
  id         String    @id @default(cuid())
  orgId      String
  title      String
  dueAt      DateTime
  done       Boolean   @default(false)
  ownerId    String
  owner      User      @relation("TaskOwner", fields: [ownerId], references: [id])
  entity     String? // Account | Deal | Contact
  entityId   String?
  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([ownerId, done, dueAt])
}

model Document {
  id        String         @id @default(cuid())
  orgId     String
  dealId    String
  deal      Deal           @relation(fields: [dealId], references: [id])
  kind      DocumentKind
  version   Int            @default(1)
  status    DocumentStatus @default(DRAFT)
  esignId   String?
  fileKey   String?
  createdAt DateTime       @default(now())
}

model AuditLog {
  id       String   @id @default(cuid())
  orgId    String
  actorId  String?
  entity   String
  entityId String
  action   String
  diff     Json?
  at       DateTime @default(now())

  @@index([orgId, entity, entityId])
}

model Approval {
  id            String         @id @default(cuid())
  orgId         String
  dealId        String
  deal          Deal           @relation(fields: [dealId], references: [id], onDelete: Cascade)
  kind          ApprovalKind
  detail        String
  discountPct   Int?
  status        ApprovalStatus @default(PENDING)
  requestedById String
  decidedById   String?
  decisionNote  String?
  decidedAt     DateTime?
  createdAt     DateTime       @default(now())

  @@index([orgId, status])
}

/// Client invoices raised by the India entity; drive the monthly Net Revenue statement for the licence fee.
model Invoice {
  id           String    @id @default(cuid())
  orgId        String
  dealId       String
  deal         Deal      @relation(fields: [dealId], references: [id])
  number       String
  issuedAt     DateTime
  amountInr    Int // taxable value, excluding GST
  gstInr       Int       @default(0)
  collectedInr Int       @default(0)
  collectedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@unique([orgId, number])
  @@index([orgId, issuedAt])
}
