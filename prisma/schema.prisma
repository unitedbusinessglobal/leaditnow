// LeadItNow data model. Every table carries orgId so the product can go multi-tenant later.

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  FOUNDER
  DIRECTOR
  BA
  SALES
  INTERN
  SALES_LEAD
}

enum DealStage {
  TARGET
  OUTREACH
  DISCOVERY
  PROTOTYPE_DEMO
  MOU_SCOPING
  MSA_SOW
  ONBOARD
  RENEW_EXPAND
  LOST
}

enum ActivityType {
  EMAIL
  WHATSAPP
  CALL
  MEETING
  NOTE
  STAGE_CHANGE
}

enum DocumentKind {
  MOU
  MSA
  SOW
  PROPOSAL
}

enum DocumentStatus {
  DRAFT
  SENT
  SIGNED
  DECLINED
}

enum SignalCategory {
  NEED
  STACK
}

enum CandidateStatus {
  NEW
  ADDED
  DISMISSED
}

enum ApprovalKind {
  DISCOUNT
  TERMS
  PRICING
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ScanStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

model Organization {
  id        String    @id @default(cuid())
  name      String
  plan      String    @default("internal")
  /// Estimate settings: { itSpendPct: { [industry]: number }, usdInr: number, itPerEmployeeInr: number }
  settings  Json?
  createdAt DateTime  @default(now())
  users     User[]
  accounts  Account[]
  teams     Team[]
}

/// A sales team. New leads are assigned to a team; the team lead or a member picks them up.
model Team {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id])
  name      String
  leadId    String?
  lead      User?        @relation("TeamLead", fields: [leadId], references: [id])
  members   User[]       @relation("TeamMembers")
  accounts  Account[]
  createdAt DateTime     @default(now())

  @@unique([orgId, name])
}

model User {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id])
  email     String       @unique
  name      String
  role      Role
  active    Boolean      @default(true)
  lastLoginAt DateTime?
  createdAt DateTime     @default(now())
  accounts  Account[]    @relation("AccountOwner")
  deals     Deal[]       @relation("DealOwner")
  tasks     Task[]       @relation("TaskOwner")
  activities Activity[]  @relation("ActivityUser")
  teamId    String?
  team      Team?        @relation("TeamMembers", fields: [teamId], references: [id])
  leads     Team[]       @relation("TeamLead")
  tasksGiven Task[]      @relation("TaskAssigner")
}

model Account {
  id         String          @id @default(cuid())
  orgId      String
  org        Organization    @relation(fields: [orgId], references: [id])
  name       String
  domain     String
  gstin      String?
  industry   String?
  city       String?
  staffSize  Int?
  phone      String?
  source     String          @default("manual") // manual | csv:<file> | hubspot | apollo
  sourceNote String? // where the record came from and why we hold it (DPDP Act)
  notes      String?
  lastScannedAt DateTime?
  placeId    String? // Google Places ID (the only Places field we may keep indefinitely)
  apolloId   String?
  // Size and finance (Apollo enrichment, company register, or entered by hand)
  revenueInr     Float?
  revenueSource  String? // apollo | manual | register
  listed         Boolean?
  stockSymbol    String?
  stockExchange  String?
  foundedYear    Int?
  technologies   String[]  @default([])
  paidUpCapitalInr Float?
  companyClass   String? // Private | Public | OPC | LLP
  cin            String?
  enrichedAt     DateTime?
  contactPoints  ContactPoint[]
  needScore   Int             @default(0)
  needLabel   String          @default("None")
  stack       String[]
  serviceHint String?
  fitScore    Int             @default(0)
  priority    Int             @default(0)
  ownerId    String?
  owner      User?           @relation("AccountOwner", fields: [ownerId], references: [id])
  teamId     String?
  team       Team?           @relation(fields: [teamId], references: [id])
  assignedAt DateTime? // when it last went to a team or person
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  contacts   Contact[]
  signals    Signal[]
  scans      ScanRun[]
  briefs     ResearchBrief[]
  deals      Deal[]
  activities Activity[]

  @@unique([orgId, domain])
  @@index([orgId, phone])
  @@index([orgId, priority])
  @@index([orgId, teamId, ownerId])
}

model Contact {
  id            String     @id @default(cuid())
  orgId         String
  accountId     String
  account       Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name          String
  title         String?
  email         String?
  phone         String?
  whatsappOptIn Boolean    @default(false)
  language      String     @default("en") // en | ta
  consentSource String // where we got this contact and why (DPDP Act)
  optedOutAt    DateTime?
  createdAt     DateTime   @default(now())
  activities    Activity[]
}

model Signal {
  id        String   @id @default(cuid())
  orgId     String
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ruleId      String
  category    SignalCategory
  serviceLine String?
  weight      Int
  evidence    String // DNS record or page URL plus matched text
  foundAt   DateTime @default(now())
  scanRunId String?
  manual    Boolean  @default(false)
  addedById String?

  @@index([accountId])
}

model ScanRun {
  id         String     @id @default(cuid())
  orgId      String
  accountId  String
  account    Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  status     ScanStatus @default(QUEUED)
  pages      String[]
  error      String?
  startedAt  DateTime   @default(now())
  finishedAt DateTime?
}

model ResearchBrief {
  id           String   @id @default(cuid())
  orgId        String
  accountId    String
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  summary      String
  processes    String
  needs        String
  sources      String[]
  model        String
  reviewedById String?
  createdAt    DateTime @default(now())
}

model Deal {
  id         String     @id @default(cuid())
  orgId      String
  accountId  String
  account    Account    @relation(fields: [accountId], references: [id])
  title      String
  serviceLine     String // ERP, CRM, SaaS, e-commerce, custom app, ITES, product
  indiaOriginated Boolean @default(false) // for the 60/40 revenue share under the intercompany agreement
  stage      DealStage  @default(TARGET)
  valueInr   Int?
  nextStep   String?
  nextStepAt DateTime?
  stageChangedAt DateTime @default(now())
  pain       String? // discovery: the problem in the client's words
  budgetInr  Int? // discovery: budget the client confirmed
  championContactId String? // demo: the person who backs us internally
  liveAt     DateTime? // onboard: client live in production
  lostReason String?
  discountPct Int       @default(0)
  ownerId    String?
  owner      User?      @relation("DealOwner", fields: [ownerId], references: [id])
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  activities Activity[]
  documents  Document[]
  approvals  Approval[]
  invoices   Invoice[]

  @@index([orgId, stage])
}

model Activity {
  id        String       @id @default(cuid())
  orgId     String
  type      ActivityType
  direction String? // in | out
  outcome   String?
  body      String?
  at        DateTime     @default(now())
  userId    String?
  user      User?        @relation("ActivityUser", fields: [userId], references: [id])
  accountId String?
  account   Account?     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contactId String?
  contact   Contact?     @relation(fields: [contactId], references: [id])
  dealId    String?
  deal      Deal?        @relation(fields: [dealId], references: [id])

  @@index([orgId, at])
  @@index([accountId])
}

model Task {
  id         String    @id @default(cuid())
  orgId      String
  title      String
  dueAt      DateTime
  done       Boolean   @default(false)
  ownerId    String
  owner      User      @relation("TaskOwner", fields: [ownerId], references: [id])
  assignedById String? // set when someone else gave this task
  assignedBy User?     @relation("TaskAssigner", fields: [assignedById], references: [id])
  entity     String? // Account | Deal | Contact
  entityId   String?
  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([ownerId, done, dueAt])
}

model Document {
  id        String         @id @default(cuid())
  orgId     String
  dealId    String
  deal      Deal           @relation(fields: [dealId], references: [id])
  kind      DocumentKind
  version   Int            @default(1)
  status    DocumentStatus @default(DRAFT)
  esignId   String?
  fileKey   String?
  createdAt DateTime       @default(now())
}

model AuditLog {
  id       String   @id @default(cuid())
  orgId    String
  actorId  String?
  entity   String
  entityId String
  action   String
  diff     Json?
  at       DateTime @default(now())

  @@index([orgId, entity, entityId])
}

model Approval {
  id            String         @id @default(cuid())
  orgId         String
  dealId        String
  deal          Deal           @relation(fields: [dealId], references: [id], onDelete: Cascade)
  kind          ApprovalKind
  detail        String
  discountPct   Int?
  status        ApprovalStatus @default(PENDING)
  requestedById String
  decidedById   String?
  decisionNote  String?
  decidedAt     DateTime?
  createdAt     DateTime       @default(now())

  @@index([orgId, status])
}

/// Client invoices raised by the India entity; drive the monthly Net Revenue statement for the licence fee.
model Invoice {
  id           String    @id @default(cuid())
  orgId        String
  dealId       String
  deal         Deal      @relation(fields: [dealId], references: [id])
  number       String
  issuedAt     DateTime
  amountInr    Int // taxable value, excluding GST
  gstInr       Int       @default(0)
  collectedInr Int       @default(0)
  collectedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@unique([orgId, number])
  @@index([orgId, issuedAt])
}

/// Companies found by a lead source without a usable website: the team finds the site, then adds them.
model LeadCandidate {
  id         String          @id @default(cuid())
  orgId      String
  source     String // google-places | apollo | csv:<file>
  externalId String? // Places ID, Apollo ID or CIN
  name       String
  city       String?
  address    String?
  phone      String?
  website    String? // a social or marketplace page, not the company's own site
  industry   String?
  staffSize  Int?
  note       String?
  extra      Json? // register details carried to the account: cin, paidUpCapitalInr, listed, companyClass
  status     CandidateStatus @default(NEW)
  accountId  String?
  createdAt  DateTime        @default(now())

  @@unique([orgId, source, externalId])
  @@index([orgId, status])
}

/// A Find leads search kept to run every week.
model SavedSearch {
  id          String    @id @default(cuid())
  orgId       String
  source      String // google-places | apollo
  industry    String
  city        String
  keywords    String?
  staffRange  String? // Apollo, e.g. "11,200"
  active      Boolean   @default(true)
  lastRunAt   DateTime?
  createdById String
  createdAt   DateTime  @default(now())

  @@index([orgId, active])
}

model DiscoveryRun {
  id          String   @id @default(cuid())
  orgId       String
  source      String
  query       String
  found       Int      @default(0)
  added       Int      @default(0)
  existing    Int      @default(0)
  candidates  Int      @default(0)
  error       String?
  savedSearchId String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([orgId, createdAt])
}

/// Business emails and phone numbers published on the company's own website, with the page they came from.
model ContactPoint {
  id        String   @id @default(cuid())
  orgId     String
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind      String // email | phone
  value     String
  sourceUrl String
  source    String   @default("website") // website | hunter | snov | ...
  name      String? // person behind the email, when the provider knows
  title     String?
  confidence Int?
  foundAt   DateTime @default(now())

  @@unique([accountId, kind, value])
}
