{
  "version": 1,
  "rules": [
    {
      "id": "zoho-mail-mx",
      "source": "dns-mx",
      "pattern": "(^|\\.)mx\\d*\\.zoho\\.(in|com|eu|com\\.au)\\.?$",
      "zohoApp": "Mail",
      "weight": 30,
      "verified": true,
      "label": "Email domain's MX records point to Zoho Mail"
    },
    {
      "id": "zoho-spf",
      "source": "dns-txt",
      "pattern": "include:zoho\\.(in|com|eu|com\\.au)",
      "zohoApp": "Mail",
      "weight": 15,
      "verified": true,
      "label": "SPF record includes Zoho"
    },
    {
      "id": "zoho-forms",
      "source": "html",
      "pattern": "forms\\.zohopublic\\.(com|in|eu)",
      "zohoApp": "Forms",
      "weight": 15,
      "verified": true,
      "label": "Website embeds a Zoho Form"
    },
    {
      "id": "zoho-creator",
      "source": "html",
      "pattern": "(creatorapp\\.zohopublic\\.|creator\\.zoho\\.)",
      "zohoApp": "Creator",
      "weight": 20,
      "verified": false,
      "customNeed": true,
      "label": "Website links to or embeds a Zoho Creator app"
    },
    {
      "id": "zoho-books",
      "source": "html",
      "pattern": "books\\.zoho\\.(com|in|eu)",
      "zohoApp": "Books",
      "weight": 20,
      "verified": false,
      "label": "Zoho Books invoice or payment link"
    },
    {
      "id": "zoho-salesiq",
      "source": "html",
      "pattern": "salesiq\\.zoho(public)?\\.(com|in|eu)",
      "zohoApp": "SalesIQ",
      "weight": 10,
      "verified": false,
      "label": "Zoho SalesIQ chat widget on the website"
    },
    {
      "id": "zoho-bookings",
      "source": "html",
      "pattern": "(bookings\\.zoho\\.|zohobookings\\.)",
      "zohoApp": "Bookings",
      "weight": 10,
      "verified": false,
      "label": "Zoho Bookings page linked"
    },
    {
      "id": "zoho-desk",
      "source": "html",
      "pattern": "desk\\.zoho\\.(com|in|eu)",
      "zohoApp": "Desk",
      "weight": 10,
      "verified": false,
      "label": "Zoho Desk help centre linked"
    },
    {
      "id": "zoho-recruit",
      "source": "html",
      "pattern": "zohorecruit\\.(com|in|eu)",
      "zohoApp": "Recruit",
      "weight": 8,
      "verified": false,
      "label": "Careers page on Zoho Recruit"
    },
    {
      "id": "zoho-sites",
      "source": "html",
      "pattern": "(zohositescontent|zsite\\.zoho)",
      "zohoApp": "Sites",
      "weight": 8,
      "verified": false,
      "label": "Website appears to be built on Zoho Sites"
    },
    {
      "id": "zoho-pagesense",
      "source": "html",
      "pattern": "cdn\\.pagesense\\.io",
      "zohoApp": "PageSense",
      "weight": 5,
      "verified": false,
      "label": "Zoho PageSense script on the website"
    },
    {
      "id": "job-post-zoho",
      "source": "manual",
      "pattern": "",
      "zohoApp": "CRM",
      "weight": 15,
      "verified": false,
      "customNeed": true,
      "label": "Job post asks for Zoho skills"
    },
    {
      "id": "referral-zoho",
      "source": "manual",
      "pattern": "",
      "zohoApp": "Stated",
      "weight": 25,
      "verified": true,
      "label": "Referral says they use Zoho"
    }
  ]
}
